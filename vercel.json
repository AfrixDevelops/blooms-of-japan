{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(art|img|th|new|gal)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(styles.css|data.js|hero.js|fonts.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.bloomsofjapan.com"
        }
      ],
      "destination": "https://bloomsofjapan.com/$1",
      "permanent": true
    },
    {
      "source": "/spots/sumoto-narcissus-castle-park",
      "destination": "/flowers/narcissus",
      "permanent": true
    },
    {
      "source": "/spots/minamiawaji-narcissus-lookout",
      "destination": "/spots/nada-kuroiwa-narcissus-field",
      "permanent": true
